DATABASE_URL=postgres://user:password@localhost:5432/teesolar

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL; invite links are built from it.
BETTER_AUTH_URL=http://localhost:3000

# Cloudinary (Settings → API Keys in the Cloudinary console). Leave blank to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin, created on server start when no admin exists yet. Change the password after signing in.

